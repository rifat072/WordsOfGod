// Copy to Secrets.xcconfig (gitignored) and fill in your Quran Foundation credentials.
QF_CLIENT_ID[config=Debug] = your-prelive-client-id
QF_CLIENT_SECRET[config=Debug] = your-prelive-client-secret
QF_ENVIRONMENT[config=Debug] = prelive

QF_CLIENT_ID[config=Release] = your-production-client-id
QF_CLIENT_SECRET[config=Release] = your-production-client-secret
QF_ENVIRONMENT[config=Release] = production
